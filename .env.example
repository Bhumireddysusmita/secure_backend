# Copy to backend/.env (git-ignored) and fill in real values. Never commit .env.

# development | test | production
APP_ENV=development

# PostgreSQL connection (psycopg 3 driver is selected automatically).
DATABASE_URL=postgresql://secure_auth:<db-password>@localhost:5432/secure_auth
# Separate database used by the pytest integration suite (it is wiped between tests).
TEST_DATABASE_URL=postgresql://secure_auth:<db-password>@localhost:5432/secure_auth_test

# 32+ random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=<random-48-byte-string>

# Cloudflare Turnstile secret key (server-side only, never sent to the browser).
# Cloudflare official TEST secret keys for local / CI use:
#   1x0000000000000000000000000000000AA  -> always passes
#   2x0000000000000000000000000000000AA  -> always fails
#   3x0000000000000000000000000000000AA  -> yields a "token already spent" error
# Production: use the secret from your Cloudflare dashboard.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Browser origin(s) allowed to call POST endpoints (comma-separated).
APP_URL=http://localhost:5173

# Session cookie. COOKIE_SECURE defaults to true when APP_ENV=production.
# COOKIE_SECURE=true
SESSION_TTL_DAYS=7

# bcrypt cost factor (12 in dev/prod; tests may lower it for speed).
BCRYPT_ROUNDS=12

# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Rate limits (defaults shown).
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_MINUTES=15
SIGNUP_MAX_PER_IP=10
SIGNUP_MAX_PER_EMAIL=5
SIGNUP_WINDOW_MINUTES=60

# Optional: shared password for the 25 demo users created by scripts/seed_users.py
# (development only; the script refuses to run when APP_ENV=production).
# SEED_USER_PASSWORD=<choose-a-password>

# Optional: serve the built React app from the API (single-origin production deploy).
# FRONTEND_DIST=../frontend/dist
